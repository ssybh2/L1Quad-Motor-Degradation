FROM px4io/px4-dev-simulation-jammy:2024-05-18

SHELL ["/bin/bash", "-lc"]
USER root
WORKDIR /workspace

# PX4 d6f12ad (v1.17 base) explicitly installs Gazebo Harmonic on Ubuntu 22.04.
# The legacy Jammy dev image by itself only has part of the modern gz stack, so
# install Harmonic from OSRF here to make `make px4_sitl gz_x500` reproducible.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        gnupg \
        lsb-release \
        wget \
    && wget -q https://packages.osrfoundation.org/gazebo.gpg \
        -O /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] http://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" \
        > /etc/apt/sources.list.d/gazebo-stable.list \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        gz-harmonic \
        libunwind-dev \
    && rm -rf /var/lib/apt/lists/*

ENV DEBIAN_FRONTEND=noninteractive
ENV GZ_DISTRO=harmonic
ENV QT_X11_NO_MITSHM=1

# Project source is bind-mounted by docker-compose. Controller edits therefore
# do not require rebuilding this image; only dependency changes do.
CMD ["/bin/bash"]
